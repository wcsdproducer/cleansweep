rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────

    /** Returns true if the request comes from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Returns true if the signed-in user owns the given userId path segment. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Returns true if the signed-in user has the 'Service Provider' role. */
    function isServiceProvider() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Service Provider';
    }

    /** Returns true if the signed-in user has an entry in the roles_admin collection. */
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }


    // ─── Customer Portal (Main Site) ─────────────────────────────────────────

    match /customers/{customerId} {
      allow get, list: if isOwner(customerId);
      allow create:    if isOwner(customerId) && request.resource.data.id == customerId;
      allow update:    if isOwner(customerId) && request.resource.data.id == resource.data.id;
      allow delete:    if isAdmin();

      match /quotes/{quoteId} {
        allow get, list: if isOwner(customerId);
        allow create:    if isOwner(customerId) && request.resource.data.customerId == customerId;
        allow update:    if isOwner(customerId) && request.resource.data.customerId == resource.data.customerId;
        allow delete:    if isAdmin();
      }
    }

    match /contactSubmissions/{submissionId} {
      allow create:                  if true;     // Anyone can submit the contact form
      allow get, list, update, delete: if isAdmin();
    }


    // ─── Service Provider Portal (Connect App) ───────────────────────────────

    // users/{uid} — RBAC role document.
    // Connect dashboard layout reads this to verify role === 'Service Provider'.
    // Admin app can manage all user docs.
    match /users/{userId} {
      allow get:    if isOwner(userId) || isAdmin();
      allow list:   if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // serviceProviders/{uid} — Provider profile. Created on registration.
    // Providers read/write only their own. Admins can read/write all.
    match /serviceProviders/{providerId} {
      allow get:    if isOwner(providerId) || isAdmin();
      allow list:   if isAdmin();
      allow create: if isOwner(providerId);
      allow update: if isOwner(providerId) || isAdmin();
      allow delete: if isAdmin();

      // payoutTransactions subcollection — provider reads own, admin manages all
      match /payoutTransactions/{txId} {
        allow get, list: if isOwner(providerId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // serviceJobs — Jobs assigned to providers.
    // Providers can only read jobs assigned to their UID.
    // Admins can read/write all jobs.
    match /serviceJobs/{jobId} {
      allow get:    if isAdmin() ||
                       (isServiceProvider() && resource.data.serviceProviderId == request.auth.uid);
      allow list:   if isAdmin() ||
                       isServiceProvider(); // query always filtered by serviceProviderId in app
      allow create, update, delete: if isAdmin();
    }

    // conversations — Message threads between providers and admins/customers.
    // Participants can read; providers can write (send messages).
    match /conversations/{conversationId} {
      allow get, list: if isSignedIn() &&
                          request.auth.uid in resource.data.participantIds;
      allow create:    if isSignedIn();
      allow update:    if isSignedIn() &&
                          request.auth.uid in resource.data.participantIds;
      allow delete:    if isAdmin();
    }

    // messages — Individual chat messages.
    // Participants of the parent conversation can read/create.
    match /messages/{messageId} {
      allow get, list: if isSignedIn();  // Firestore queries are filtered client-side by conversationId
      allow create:    if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // provider_coverage — Geographic coverage areas.
    // Each provider owns their own document. Admins see all.
    match /provider_coverage/{providerId} {
      allow get:    if isOwner(providerId) || isAdmin();
      allow list:   if isAdmin();
      allow create, update: if isOwner(providerId) || isAdmin();
      allow delete: if isAdmin();
    }


    // ─── Admin App Only ──────────────────────────────────────────────────────

    // _system_health — Used by the Admin monitoring page for latency tests.
    match /_system_health/{docId} {
      allow read, write: if isAdmin();
    }

    // zip_codes — Reference data for coverage lookups.
    match /zip_codes/{zipId} {
      allow get, list: if isAdmin() || isServiceProvider();
      allow create, update, delete: if isAdmin();
    }


    // ─── Public Catalog (Main Site) ──────────────────────────────────────────

    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /checklistItems/{itemId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials_public/{testimonialId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials_pending/{testimonialId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /franchiseApplications/{applicationId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }


    // ─── Access Control ──────────────────────────────────────────────────────

    // roles_admin — Tracks admin UIDs. Never publicly readable or writable.
    match /roles_admin/{uid} {
      allow read, write: if false;
    }
  }
}